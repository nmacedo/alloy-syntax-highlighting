{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alloy",
  "comment": "Declaration contexts resolve overloaded tokens before expression fallbacks. Root expressions cover function return types without guessing their boundaries. See docs/limitations.md.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#module-declarations-and-imports"
    },
    {
      "include": "#signature-declarations"
    },
    {
      "include": "#callable-declarations"
    },
    {
      "include": "#top-level-let-declarations"
    },
    {
      "include": "#declaration-keywords"
    },
    {
      "include": "#meta-identifiers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#block-expressions"
    },
    {
      "include": "#expression-brackets"
    },
    {
      "include": "#expression-blocks"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.alloy",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.alloy"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.line.double-dash.alloy",
          "begin": "--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.alloy"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.documentation.alloy",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.alloy"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.alloy"
            }
          }
        },
        {
          "name": "comment.block.alloy",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.alloy"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.alloy"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "meta.string.alloy",
      "contentName": "string.quoted.double.alloy",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.alloy"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.alloy"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.alloy",
          "match": "\\\\."
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "storage.type.function.alloy keyword.declaration.function.alloy",
          "match": "\\b(pred|fun)\\b"
        },
        {
          "name": "storage.type.enum.alloy keyword.declaration.enum.alloy",
          "match": "\\b(enum)\\b"
        },
        {
          "name": "storage.type.namespace.alloy keyword.declaration.namespace.alloy",
          "match": "\\b(module)\\b"
        },
        {
          "name": "keyword.declaration.command.alloy",
          "match": "\\b(run|check)\\b"
        },
        {
          "name": "keyword.declaration.assert.alloy",
          "match": "\\b(assert)\\b"
        },
        {
          "name": "keyword.declaration.fact.alloy",
          "match": "\\b(fact)\\b"
        }
      ]
    },
    "top-level-let-declarations": {
      "comment": "Top-level macros have optional untyped parameters and either = or brace bodies.",
      "patterns": [
        {
          "comment": "End after a brace body or before the next declaration. This conservative boundary misidentifies inner let-expressions in undelimited = bodies.",
          "begin": "\\blet\\b",
          "beginCaptures": {
            "0": {
              "name": "storage.type.function.alloy keyword.declaration.function.alloy"
            }
          },
          "end": "(?<=\\})|(?=(?:[ \\t]+|/\\*[\\s\\S]*?\\*/|//[^\\r\\n]*|--[^\\r\\n]*)*(?:(?:private|abstract|one|lone|some|var)\\b[ \\t]+)*(?:module|open|sig|enum|pred|fun|fact|assert|run|check|let)\\b)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#top-level-let-header"
            },
            {
              "include": "#top-level-let-expression-body"
            },
            {
              "include": "#top-level-let-block-body"
            }
          ]
        }
      ]
    },
    "top-level-let-header": {
      "comment": "Read the name and optional untyped parameters; leave = or { for the body rule.",
      "begin": "(?=[A-Za-z_])",
      "end": "(?=(?:\\s|//[^\\r\\n]*|--[^\\r\\n]*|/\\*[\\s\\S]*?\\*/)*(?:=|\\{))",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.alloy"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.alloy"
            }
          },
          "patterns": [
            {
              "include": "#identifier-list-items"
            }
          ]
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "top-level-let-expression-body": {
      "comment": "The opening = is assignment; RHS signs are comparisons. Yielding to declaration keywords also prematurely ends the scope at inner let-expressions.",
      "name": "meta.binding.macro.alloy",
      "begin": "=",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.assignment.alloy"
        }
      },
      "end": "(?=(?:[ \\t]+|/\\*[\\s\\S]*?\\*/|//[^\\r\\n]*|--[^\\r\\n]*)*(?:(?:private|abstract|one|lone|some|var)\\b[ \\t]+)*(?:module|open|sig|enum|pred|fun|fact|assert|run|check|let)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#block-expressions"
        }
      ]
    },
    "top-level-let-block-body": {
      "comment": "expression-blocks consumes the balanced brace body before this wrapper ends.",
      "name": "meta.binding.macro.alloy",
      "begin": "(?=\\{)",
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#block-expressions"
        }
      ]
    },
    "callable-declarations": {
      "comment": "Carry the header across comments and line breaks. A nested parameter list owns its delimiters; leave the return-type : or body { to root expression rules.",
      "begin": "\\b(fun|pred)\\b",
      "beginCaptures": {
        "0": {
          "name": "storage.type.function.alloy keyword.declaration.function.alloy"
        }
      },
      "end": "(?=[:{])",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#callable-declaration-parameters"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "callable-declaration-parameters": {
      "comment": "Parameter lists are optional. Enter at [ within a callable header; nested expression brackets shield inner ] tokens.",
      "contentName": "meta.brackets.alloy meta.parameters.alloy",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.alloy"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.alloy"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#callable-parameter-value"
        },
        {
          "name": "storage.modifier.alloy",
          "match": "\\b(disj|var)\\b(?!\\$)"
        },
        {
          "name": "punctuation.separator.alloy",
          "match": ","
        },
        {
          "include": "#block-expressions"
        }
      ]
    },
    "identifier-list-items": {
      "comment": "Untyped identifiers shared by module arguments and macro parameters.",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "punctuation.separator.alloy",
          "match": ","
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "module-path-arguments": {
      "name": "meta.parameters.module.alloy",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.alloy"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.alloy"
        }
      },
      "patterns": [
        {
          "include": "#identifier-list-items"
        }
      ]
    },
    "module-path-components": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#module-path-arguments"
        },
        {
          "name": "variable.other.alloy",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.accessor.alloy",
          "match": "/"
        }
      ]
    },
    "module-declarations-and-imports": {
      "comment": "Paths lack a terminator; the next declaration keyword or modifier is a conservative boundary, not a complete path parse.",
      "patterns": [
        {
          "name": "meta.path.module.alloy",
          "begin": "\\b(module)\\b",
          "beginCaptures": {
            "0": {
              "name": "storage.type.namespace.alloy"
            }
          },
          "end": "(?=(?:\\s|//[^\\r\\n]*|--[^\\r\\n]*|/\\*[\\s\\S]*?\\*/)*(?:open|sig|enum|pred|fun|fact|assert|run|check|let|private|abstract|one|lone|some|var)\\b)",
          "patterns": [
            {
              "include": "#module-path-components"
            }
          ]
        },
        {
          "name": "meta.path.open.alloy",
          "begin": "\\b(open)\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.import.alloy"
            }
          },
          "end": "(?=(?:\\s|//[^\\r\\n]*|--[^\\r\\n]*|/\\*[\\s\\S]*?\\*/)*(?:open|sig|enum|pred|fun|fact|assert|run|check|let|private|abstract|one|lone|some|var)\\b)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "keyword.control.import.as.alloy",
              "match": "\\bas\\b"
            },
            {
              "include": "#module-path-components"
            }
          ]
        }
      ]
    },
    "signature-declarations": {
      "patterns": [
        {
          "name": "storage.modifier.alloy",
          "match": "\\b(abstract|private|var)\\b(?!\\$)"
        },
        {
          "comment": "Treat multiplicities as modifiers when sig follows on this line, allowing comments and other modifiers. Exclude sig$.",
          "name": "storage.modifier.alloy",
          "match": "\\b(one|lone|some)\\b(?=(?:(?:\\s+)|/\\*[\\s\\S]*?\\*/|//[^\\r\\n]*|--[^\\r\\n]*|\\b(?:abstract|private|var|one|lone|some)\\b)*\\bsig\\b(?!\\$))"
        },
        {
          "comment": "Keep hierarchy and fields together. Nested contexts shield inner braces; a following signature fact block is handled at the root.",
          "begin": "(?=\\bsig\\b(?!\\$))",
          "end": "(?<=\\})",
          "patterns": [
            {
              "name": "storage.type.alloy keyword.declaration.type.alloy",
              "match": "\\b(sig)\\b(?!\\$)"
            },
            {
              "include": "#signature-hierarchy"
            },
            {
              "include": "#signature-fields"
            }
          ]
        }
      ]
    },
    "meta-identifiers": {
      "comment": "Recognize $-suffixed meta-identifiers before keyword and identifier fallbacks.",
      "patterns": [
        {
          "name": "support.constant.alloy",
          "match": "\\b(sig|field)\\$(?![A-Za-z0-9_])"
        },
        {
          "name": "support.constant.alloy",
          "match": "\\b(static|var)\\$(?![A-Za-z0-9_])"
        },
        {
          "name": "punctuation.accessor.alloy",
          "match": "\\$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.alloy",
          "match": "\\b(for|but|exactly|expect|with)\\b"
        },
        {
          "name": "keyword.other.alloy",
          "match": "\\b(enabled|event|invariant|modifies)\\b"
        },
        {
          "comment": "Built-in signature/scope names; earlier expression rules override int and seq within expression contexts.",
          "name": "support.type.alloy",
          "match": "\\b(Int|String|int|seq|steps)\\b"
        },
        {
          "name": "variable.language.alloy",
          "match": "\\b(this)\\b"
        }
      ]
    },
    "expression-groups": {
      "comment": "Recursive delimiters shield nested tokens from enclosing declaration boundaries.",
      "name": "meta.group.alloy",
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.alloy"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.alloy"
        }
      },
      "patterns": [
        {
          "include": "#block-expressions"
        }
      ]
    },
    "expression-brackets": {
      "comment": "Nested ] tokens belong to this context, not the enclosing parameter list.",
      "name": "meta.brackets.alloy",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.alloy"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.alloy"
        }
      },
      "patterns": [
        {
          "name": "storage.modifier.alloy",
          "match": "\\b(disj)\\b(?!\\$)"
        },
        {
          "include": "#block-expressions"
        }
      ]
    },
    "expression-blocks": {
      "comment": "Balance braces for formulas, expressions, and comprehensions without parsing their structure.",
      "name": "meta.block.alloy",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.alloy"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.alloy"
        }
      },
      "patterns": [
        {
          "include": "#block-expressions"
        }
      ]
    },
    "block-expressions": {
      "comment": "Order matters: multiplicity modifiers before word operators, punctuation before overlapping operators, and int/seq expression roles before built-in names. No precedence parsing.",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#expression-groups"
        },
        {
          "include": "#expression-brackets"
        },
        {
          "include": "#expression-blocks"
        },
        {
          "comment": "After : or ->, wait across whitespace/comments for an optional multiplicity modifier; otherwise return without consuming the next token. Preserve :>.",
          "begin": "(:)(?!>)|(->)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.alloy"
            },
            "2": {
              "name": "keyword.operator.expression.alloy"
            }
          },
          "end": "((?:one|lone|some|set)\\b)|(?=\\S)(?!/\\*|//|--)",
          "endCaptures": {
            "1": {
              "name": "storage.modifier.alloy"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            }
          ]
        },
        {
          "comment": "Same-line fallback when the declaration rule already consumed :.",
          "name": "storage.modifier.alloy",
          "match": "(?<=:)\\s*(one|lone|some|set)\\b"
        },
        {
          "comment": "Same-line fallback after an already-consumed arrow.",
          "name": "storage.modifier.alloy",
          "match": "(?<=->)\\s*(one|lone|some|set)\\b"
        },
        {
          "include": "#punctuation"
        },
        {
          "name": "storage.modifier.alloy",
          "match": "\\b(disj|var)\\b(?!\\$)"
        },
        {
          "comment": "Modifier only if -> follows on this line. An arrow on a later line cannot be detected.",
          "name": "storage.modifier.alloy",
          "match": "\\b(one|lone|some|set)\\b(?=(?:(?:\\s+)|/\\*[\\s\\S]*?\\*/|//[^\\r\\n]*|--[^\\r\\n]*)*->)"
        },
        {
          "name": "keyword.operator.word.alloy",
          "match": "\\b(and|or|not|implies|iff|else)\\b"
        },
        {
          "name": "keyword.operator.word.alloy",
          "match": "\\b(all|no|one|some|lone)\\b"
        },
        {
          "name": "keyword.operator.word.alloy",
          "match": "\\b(always|eventually|after|before|until|releases|since|triggered|historically|once)\\b"
        },
        {
          "comment": "Expression bindings end before a single | or a body brace. The brace lookahead excludes only simple name: comprehensions.",
          "name": "meta.binding.let.alloy",
          "begin": "\\blet\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.word.alloy"
            }
          },
          "end": "(?=\\|(?!\\|)|\\{(?!\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:))",
          "patterns": [
            {
              "comment": "Consume the binding = as assignment; RHS signs are comparisons. Leave the body delimiter unconsumed.",
              "name": "meta.binding.let.alloy",
              "begin": "=",
              "beginCaptures": {
                "0": {
                  "name": "meta.binding.let.alloy keyword.operator.assignment.alloy"
                }
              },
              "end": "(?=\\|(?!\\|)|\\{(?!\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:))",
              "patterns": [
                {
                  "include": "#comments"
                },
                {
                  "include": "#strings"
                },
                {
                  "comment": "A top-level comma starts another binding. Consume its = as assignment, or yield if no binding follows.",
                  "begin": ",",
                  "beginCaptures": {
                    "0": {
                      "name": "punctuation.separator.alloy"
                    }
                  },
                  "end": "(=)|(?=\\S)(?![A-Za-z_]|/\\*|//|--)",
                  "endCaptures": {
                    "1": {
                      "name": "meta.binding.let.alloy keyword.operator.assignment.alloy"
                    }
                  },
                  "patterns": [
                    {
                      "include": "#comments"
                    },
                    {
                      "include": "#strings"
                    },
                    {
                      "include": "#identifiers"
                    }
                  ]
                },
                {
                  "include": "#block-expressions"
                }
              ]
            },
            {
              "include": "#block-expressions"
            }
          ]
        },
        {
          "name": "keyword.operator.word.alloy",
          "match": "\\b(in)\\b"
        },
        {
          "comment": "Expression operators; precede the int command-scope fallback.",
          "name": "keyword.operator.word.alloy",
          "match": "\\b(sum|int)\\b"
        },
        {
          "comment": "Type-constructor modifier, distinct from the seq command-scope name.",
          "name": "storage.modifier.alloy",
          "match": "\\b(seq)\\b"
        },
        {
          "comment": "; is a temporal logical operator, not punctuation.",
          "name": "keyword.operator.logical.alloy",
          "match": "<=>|=>|!|&&|\\|\\||;"
        },
        {
          "name": "keyword.operator.bitwise.alloy",
          "match": ">>>|>>|<<"
        },
        {
          "name": "keyword.operator.expression.alloy",
          "match": "\\+\\+|->|<:|:>|\\+|-|&|\\*|\\^|~|\\.|#|'"
        },
        {
          "name": "keyword.operator.comparison.alloy",
          "match": "=<|>=|=|<|>"
        },
        {
          "include": "#meta-identifiers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "comment": "Match command ranges .. before the join operator .",
          "name": "punctuation.separator.alloy",
          "match": "\\.\\."
        },
        {
          "comment": "Preserve :> and || as operators; match only the single binder |.",
          "name": "punctuation.separator.alloy",
          "match": ",|:(?!>)|(?<!\\|)\\|(?!\\|)"
        },
        {
          "name": "punctuation.definition.variable.alloy",
          "match": "@"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.alloy",
          "match": "\\b0x(?:_|[0-9A-Fa-f]{2})+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.alloy",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.alloy",
          "match": "\\b[0-9][0-9_]*\\b"
        },
        {
          "name": "variable.language.alloy",
          "match": "\\b(univ|iden|none)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.alloy",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "signature-hierarchy": {
      "comment": "Keep the hierarchy after sig until {, across lines. Here = is assignment and in/extends are hierarchy keywords.",
      "name": "meta.signature.hierarchy.alloy",
      "begin": "(?<=sig)",
      "end": "(?=\\{)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#meta-identifiers"
        },
        {
          "name": "keyword.other.alloy",
          "match": "\\b(extends|in)\\b"
        },
        {
          "name": "keyword.operator.expression.alloy",
          "match": "\\+"
        },
        {
          "name": "keyword.operator.assignment.alloy",
          "match": "="
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "signature-fields": {
      "comment": "Field declarations precede expression fallbacks; nested contexts shield their own closing braces.",
      "name": "meta.block.signature.fields.alloy",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.alloy"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.alloy"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
