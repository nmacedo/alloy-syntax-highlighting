<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>$schema</key>
	<string>https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json</string>
	<key>name</key>
	<string>Alloy</string>
	<key>comment</key>
	<string>Declaration contexts resolve overloaded tokens before expression fallbacks. Root expressions cover function return types without guessing their boundaries. See docs/limitations.md.</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#module-declarations-and-imports</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#signature-declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#callable-declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#top-level-let-declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#declaration-keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#meta-identifiers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#block-expressions</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#expression-brackets</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#expression-blocks</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#punctuation</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constants</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#identifiers</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>comment.line.double-slash.alloy</string>
					<key>begin</key>
					<string>//</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>$</string>
				</dict>
				<dict>
					<key>name</key>
					<string>comment.line.double-dash.alloy</string>
					<key>begin</key>
					<string>--</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>$</string>
				</dict>
				<dict>
					<key>name</key>
					<string>comment.block.documentation.alloy</string>
					<key>begin</key>
					<string>/\*\*(?!/)</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>\*/</string>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.alloy</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>name</key>
					<string>comment.block.alloy</string>
					<key>begin</key>
					<string>/\*</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>\*/</string>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.alloy</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>name</key>
			<string>meta.string.alloy</string>
			<key>contentName</key>
			<string>string.quoted.double.alloy</string>
			<key>begin</key>
			<string>"</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.string.begin.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>"</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.string.end.alloy</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.alloy</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
			</array>
		</dict>
		<key>declaration-keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>storage.type.function.alloy keyword.declaration.function.alloy</string>
					<key>match</key>
					<string>\b(pred|fun)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.type.enum.alloy keyword.declaration.enum.alloy</string>
					<key>match</key>
					<string>\b(enum)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.type.namespace.alloy keyword.declaration.namespace.alloy</string>
					<key>match</key>
					<string>\b(module)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.declaration.command.alloy</string>
					<key>match</key>
					<string>\b(run|check)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.declaration.assert.alloy</string>
					<key>match</key>
					<string>\b(assert)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.declaration.fact.alloy</string>
					<key>match</key>
					<string>\b(fact)\b</string>
				</dict>
			</array>
		</dict>
		<key>top-level-let-declarations</key>
		<dict>
			<key>comment</key>
			<string>Top-level macros have optional untyped parameters and either = or brace bodies.</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>comment</key>
					<string>End after a brace body or before the next declaration. This conservative boundary misidentifies inner let-expressions in undelimited = bodies.</string>
					<key>begin</key>
					<string>\blet\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>storage.type.function.alloy keyword.declaration.function.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>(?&lt;=\})|(?=(?:[ \t]+|/\*[\s\S]*?\*/|//[^\r\n]*|--[^\r\n]*)*(?:(?:private|abstract|one|lone|some|var)\b[ \t]+)*(?:module|open|sig|enum|pred|fun|fact|assert|run|check|let)\b)</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#comments</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#strings</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#top-level-let-header</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#top-level-let-expression-body</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#top-level-let-block-body</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>top-level-let-header</key>
		<dict>
			<key>comment</key>
			<string>Read the name and optional untyped parameters; leave = or { for the body rule.</string>
			<key>begin</key>
			<string>(?=[A-Za-z_])</string>
			<key>end</key>
			<string>(?=(?:\s|//[^\r\n]*|--[^\r\n]*|/\*[\s\S]*?\*/)*(?:=|\{))</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>begin</key>
					<string>\[</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.section.brackets.begin.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>\]</string>
					<key>endCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.section.brackets.end.alloy</string>
						</dict>
					</dict>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#identifier-list-items</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>include</key>
					<string>#identifiers</string>
				</dict>
			</array>
		</dict>
		<key>top-level-let-expression-body</key>
		<dict>
			<key>comment</key>
			<string>The opening = is assignment; RHS signs are comparisons. Yielding to declaration keywords also prematurely ends the scope at inner let-expressions.</string>
			<key>name</key>
			<string>meta.binding.macro.alloy</string>
			<key>begin</key>
			<string>=</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>(?=(?:[ \t]+|/\*[\s\S]*?\*/|//[^\r\n]*|--[^\r\n]*)*(?:(?:private|abstract|one|lone|some|var)\b[ \t]+)*(?:module|open|sig|enum|pred|fun|fact|assert|run|check|let)\b)</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#strings</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>top-level-let-block-body</key>
		<dict>
			<key>comment</key>
			<string>expression-blocks consumes the balanced brace body before this wrapper ends.</string>
			<key>name</key>
			<string>meta.binding.macro.alloy</string>
			<key>begin</key>
			<string>(?=\{)</string>
			<key>end</key>
			<string>(?&lt;=\})</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#strings</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>callable-declarations</key>
		<dict>
			<key>comment</key>
			<string>Carry the header across comments and line breaks. A nested parameter list owns its delimiters; leave the return-type : or body { to root expression rules.</string>
			<key>begin</key>
			<string>\b(fun|pred)\b</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>storage.type.function.alloy keyword.declaration.function.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>(?=[:{])</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#callable-declaration-parameters</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#identifiers</string>
				</dict>
			</array>
		</dict>
		<key>callable-declaration-parameters</key>
		<dict>
			<key>comment</key>
			<string>Parameter lists are optional. Enter at [ within a callable header; nested expression brackets shield inner ] tokens.</string>
			<key>contentName</key>
			<string>meta.brackets.alloy meta.parameters.alloy</string>
			<key>begin</key>
			<string>\[</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.begin.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>\]</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.end.alloy</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#strings</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#callable-parameter-value</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(disj|var)\b(?!\$)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.separator.alloy</string>
					<key>match</key>
					<string>,</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>identifier-list-items</key>
		<dict>
			<key>comment</key>
			<string>Untyped identifiers shared by module arguments and macro parameters.</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.separator.alloy</string>
					<key>match</key>
					<string>,</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#identifiers</string>
				</dict>
			</array>
		</dict>
		<key>module-path-arguments</key>
		<dict>
			<key>name</key>
			<string>meta.parameters.module.alloy</string>
			<key>begin</key>
			<string>\[</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.begin.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>\]</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.end.alloy</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#identifier-list-items</string>
				</dict>
			</array>
		</dict>
		<key>module-path-components</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#module-path-arguments</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.alloy</string>
					<key>match</key>
					<string>\b[A-Za-z_][A-Za-z0-9_]*\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.accessor.alloy</string>
					<key>match</key>
					<string>/</string>
				</dict>
			</array>
		</dict>
		<key>module-declarations-and-imports</key>
		<dict>
			<key>comment</key>
			<string>Paths lack a terminator; the next declaration keyword or modifier is a conservative boundary, not a complete path parse.</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>meta.path.module.alloy</string>
					<key>begin</key>
					<string>\b(module)\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>storage.type.namespace.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>(?=(?:\s|//[^\r\n]*|--[^\r\n]*|/\*[\s\S]*?\*/)*(?:open|sig|enum|pred|fun|fact|assert|run|check|let|private|abstract|one|lone|some|var)\b)</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#module-path-components</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>name</key>
					<string>meta.path.open.alloy</string>
					<key>begin</key>
					<string>\b(open)\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>keyword.control.import.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>(?=(?:\s|//[^\r\n]*|--[^\r\n]*|/\*[\s\S]*?\*/)*(?:open|sig|enum|pred|fun|fact|assert|run|check|let|private|abstract|one|lone|some|var)\b)</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#comments</string>
						</dict>
						<dict>
							<key>name</key>
							<string>keyword.control.import.as.alloy</string>
							<key>match</key>
							<string>\bas\b</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#module-path-components</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>signature-declarations</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(abstract|private|var)\b(?!\$)</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Treat multiplicities as modifiers when sig follows on this line, allowing comments and other modifiers. Exclude sig$.</string>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(one|lone|some)\b(?=(?:(?:\s+)|/\*[\s\S]*?\*/|//[^\r\n]*|--[^\r\n]*|\b(?:abstract|private|var|one|lone|some)\b)*\bsig\b(?!\$))</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Keep hierarchy and fields together. Nested contexts shield inner braces; a following signature fact block is handled at the root.</string>
					<key>begin</key>
					<string>(?=\bsig\b(?!\$))</string>
					<key>end</key>
					<string>(?&lt;=\})</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>storage.type.alloy keyword.declaration.type.alloy</string>
							<key>match</key>
							<string>\b(sig)\b(?!\$)</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#signature-hierarchy</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#signature-fields</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>meta-identifiers</key>
		<dict>
			<key>comment</key>
			<string>Recognize $-suffixed meta-identifiers before keyword and identifier fallbacks.</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>support.constant.alloy</string>
					<key>match</key>
					<string>\b(sig|field)\$(?![A-Za-z0-9_])</string>
				</dict>
				<dict>
					<key>name</key>
					<string>support.constant.alloy</string>
					<key>match</key>
					<string>\b(static|var)\$(?![A-Za-z0-9_])</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.accessor.alloy</string>
					<key>match</key>
					<string>\$</string>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.control.alloy</string>
					<key>match</key>
					<string>\b(for|but|exactly|expect|with)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.other.alloy</string>
					<key>match</key>
					<string>\b(enabled|event|invariant|modifies)\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Built-in signature/scope names; earlier expression rules override int and seq within expression contexts.</string>
					<key>name</key>
					<string>support.type.alloy</string>
					<key>match</key>
					<string>\b(Int|String|int|seq|steps)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.language.alloy</string>
					<key>match</key>
					<string>\b(this)\b</string>
				</dict>
			</array>
		</dict>
		<key>expression-groups</key>
		<dict>
			<key>comment</key>
			<string>Recursive delimiters shield nested tokens from enclosing declaration boundaries.</string>
			<key>name</key>
			<string>meta.group.alloy</string>
			<key>begin</key>
			<string>\(</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.group.begin.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>\)</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.group.end.alloy</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>expression-brackets</key>
		<dict>
			<key>comment</key>
			<string>Nested ] tokens belong to this context, not the enclosing parameter list.</string>
			<key>name</key>
			<string>meta.brackets.alloy</string>
			<key>begin</key>
			<string>\[</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.begin.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>\]</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.brackets.end.alloy</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(disj)\b(?!\$)</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>expression-blocks</key>
		<dict>
			<key>comment</key>
			<string>Balance braces for formulas, expressions, and comprehensions without parsing their structure.</string>
			<key>name</key>
			<string>meta.block.alloy</string>
			<key>begin</key>
			<string>\{</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.block.begin.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>\}</string>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.block.end.alloy</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>block-expressions</key>
		<dict>
			<key>comment</key>
			<string>Order matters: multiplicity modifiers before word operators, punctuation before overlapping operators, and int/seq expression roles before built-in names. No precedence parsing.</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#strings</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#expression-groups</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#expression-brackets</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#expression-blocks</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>After : or -&gt;, wait across whitespace/comments for an optional multiplicity modifier; otherwise return without consuming the next token. Preserve :&gt;.</string>
					<key>begin</key>
					<string>(:)(?!&gt;)|(-&gt;)</string>
					<key>beginCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>punctuation.separator.alloy</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>keyword.operator.expression.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>((?:one|lone|some|set)\b)|(?=\S)(?!/\*|//|--)</string>
					<key>endCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.modifier.alloy</string>
						</dict>
					</dict>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#comments</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#strings</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>comment</key>
					<string>Same-line fallback when the declaration rule already consumed :.</string>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>(?&lt;=:)\s*(one|lone|some|set)\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Same-line fallback after an already-consumed arrow.</string>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>(?&lt;=-&gt;)\s*(one|lone|some|set)\b</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#punctuation</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(disj|var)\b(?!\$)</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Modifier only if -&gt; follows on this line. An arrow on a later line cannot be detected.</string>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(one|lone|some|set)\b(?=(?:(?:\s+)|/\*[\s\S]*?\*/|//[^\r\n]*|--[^\r\n]*)*-&gt;)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.word.alloy</string>
					<key>match</key>
					<string>\b(and|or|not|implies|iff|else)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.word.alloy</string>
					<key>match</key>
					<string>\b(all|no|one|some|lone)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.word.alloy</string>
					<key>match</key>
					<string>\b(always|eventually|after|before|until|releases|since|triggered|historically|once)\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Expression bindings end before a single | or a body brace. The brace lookahead excludes only simple name: comprehensions.</string>
					<key>name</key>
					<string>meta.binding.let.alloy</string>
					<key>begin</key>
					<string>\blet\b</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>keyword.operator.word.alloy</string>
						</dict>
					</dict>
					<key>end</key>
					<string>(?=\|(?!\|)|\{(?!\s*[A-Za-z_][A-Za-z0-9_]*\s*:))</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>comment</key>
							<string>Consume the binding = as assignment; RHS signs are comparisons. Leave the body delimiter unconsumed.</string>
							<key>name</key>
							<string>meta.binding.let.alloy</string>
							<key>begin</key>
							<string>=</string>
							<key>beginCaptures</key>
							<dict>
								<key>0</key>
								<dict>
									<key>name</key>
									<string>meta.binding.let.alloy keyword.operator.assignment.alloy</string>
								</dict>
							</dict>
							<key>end</key>
							<string>(?=\|(?!\|)|\{(?!\s*[A-Za-z_][A-Za-z0-9_]*\s*:))</string>
							<key>patterns</key>
							<array>
								<dict>
									<key>include</key>
									<string>#comments</string>
								</dict>
								<dict>
									<key>include</key>
									<string>#strings</string>
								</dict>
								<dict>
									<key>comment</key>
									<string>A top-level comma starts another binding. Consume its = as assignment, or yield if no binding follows.</string>
									<key>begin</key>
									<string>,</string>
									<key>beginCaptures</key>
									<dict>
										<key>0</key>
										<dict>
											<key>name</key>
											<string>punctuation.separator.alloy</string>
										</dict>
									</dict>
									<key>end</key>
									<string>(=)|(?=\S)(?![A-Za-z_]|/\*|//|--)</string>
									<key>endCaptures</key>
									<dict>
										<key>1</key>
										<dict>
											<key>name</key>
											<string>meta.binding.let.alloy keyword.operator.assignment.alloy</string>
										</dict>
									</dict>
									<key>patterns</key>
									<array>
										<dict>
											<key>include</key>
											<string>#comments</string>
										</dict>
										<dict>
											<key>include</key>
											<string>#strings</string>
										</dict>
										<dict>
											<key>include</key>
											<string>#identifiers</string>
										</dict>
									</array>
								</dict>
								<dict>
									<key>include</key>
									<string>#block-expressions</string>
								</dict>
							</array>
						</dict>
						<dict>
							<key>include</key>
							<string>#block-expressions</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.word.alloy</string>
					<key>match</key>
					<string>\b(in)\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Expression operators; precede the int command-scope fallback.</string>
					<key>name</key>
					<string>keyword.operator.word.alloy</string>
					<key>match</key>
					<string>\b(sum|int)\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Type-constructor modifier, distinct from the seq command-scope name.</string>
					<key>name</key>
					<string>storage.modifier.alloy</string>
					<key>match</key>
					<string>\b(seq)\b</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>; is a temporal logical operator, not punctuation.</string>
					<key>name</key>
					<string>keyword.operator.logical.alloy</string>
					<key>match</key>
					<string>&lt;=&gt;|=&gt;|!|&amp;&amp;|\|\||;</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.bitwise.alloy</string>
					<key>match</key>
					<string>&gt;&gt;&gt;|&gt;&gt;|&lt;&lt;</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.expression.alloy</string>
					<key>match</key>
					<string>\+\+|-&gt;|&lt;:|:&gt;|\+|-|&amp;|\*|\^|~|\.|#|'</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.comparison.alloy</string>
					<key>match</key>
					<string>=&lt;|&gt;=|=|&lt;|&gt;</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#meta-identifiers</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#keywords</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#constants</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#identifiers</string>
				</dict>
			</array>
		</dict>
		<key>punctuation</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>comment</key>
					<string>Match command ranges .. before the join operator .</string>
					<key>name</key>
					<string>punctuation.separator.alloy</string>
					<key>match</key>
					<string>\.\.</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>Preserve :&gt; and || as operators; match only the single binder |.</string>
					<key>name</key>
					<string>punctuation.separator.alloy</string>
					<key>match</key>
					<string>,|:(?!&gt;)|(?&lt;!\|)\|(?!\|)</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.definition.variable.alloy</string>
					<key>match</key>
					<string>@</string>
				</dict>
			</array>
		</dict>
		<key>constants</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.numeric.integer.hexadecimal.alloy</string>
					<key>match</key>
					<string>\b0x(?:_|[0-9A-Fa-f]{2})+\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.integer.binary.alloy</string>
					<key>match</key>
					<string>\b0b[01_]+\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.integer.decimal.alloy</string>
					<key>match</key>
					<string>\b[0-9][0-9_]*\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.language.alloy</string>
					<key>match</key>
					<string>\b(univ|iden|none)\b</string>
				</dict>
			</array>
		</dict>
		<key>identifiers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>variable.other.alloy</string>
					<key>match</key>
					<string>\b[A-Za-z_][A-Za-z0-9_]*\b</string>
				</dict>
			</array>
		</dict>
		<key>signature-hierarchy</key>
		<dict>
			<key>comment</key>
			<string>Keep the hierarchy after sig until {, across lines. Here = is assignment and in/extends are hierarchy keywords.</string>
			<key>name</key>
			<string>meta.signature.hierarchy.alloy</string>
			<key>begin</key>
			<string>(?&lt;=sig)</string>
			<key>end</key>
			<string>(?=\{)</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comments</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#strings</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#meta-identifiers</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.other.alloy</string>
					<key>match</key>
					<string>\b(extends|in)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.expression.alloy</string>
					<key>match</key>
					<string>\+</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.alloy</string>
