			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>(?=,|\])</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>scopeName</key>
	<string>source.alloy</string>
</dict>
