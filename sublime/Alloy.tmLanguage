				<dict>
					<key>include</key>
					<string>#field-declaration-value</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>field-declaration-value</key>
		<dict>
			<key>comment</key>
			<string>Leave : to expression rules, which retain an optional multiplicity across comments and lines; consume assignment = here. End at an unnested comma or }.</string>
			<key>name</key>
			<string>meta.declaration.field-value.alloy</string>
			<key>begin</key>
			<string>(?=:(?!&gt;))|(=)</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.alloy</string>
				</dict>
			</dict>
			<key>end</key>
			<string>(?=,|\})</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#block-expressions</string>
				</dict>
			</array>
		</dict>
		<key>callable-parameter-value</key>
